---
import Icon from "./Icon.astro";
import TransformerIllustration from "./TransformerIllustration.astro";
import DocumentationFlow from "./DocumentationFlow.astro";
import { docGroups, docPages } from "../lib/docs-plan";
interface Props { lang: "pt" | "en" }
const { lang } = Astro.props;
const pt = lang === "pt";
const base = import.meta.env.BASE_URL;
const docs = base + lang + "/docs/";
const routes = [
  { icon: "play" as const, title: pt ? "Explore com um token" : "Explore with one token", text: pt ? "Gere uma previsão, leia os tokens e acompanhe os controles do laboratório." : "Generate a prediction, read the tokens and explore the lab controls.", href: "comecar/primeiro-experimento", links: [{title: pt ? "Guia da interface" : "Interface guide", slug:"interface/mapa-componentes"},{title: "Slow motion",slug:"interface/slow-motion"}] },
  { icon: "network" as const, title: pt ? "Entenda cada cálculo" : "Understand each calculation", text: pt ? "Conecte os vetores, a atenção e as rotações às equações e aos valores reais." : "Connect vectors, attention and rotations to equations and actual values.", href: "fundamentos/atencao-causal", links: [{title: pt ? "Tokens e BPE" : "Tokens and BPE",slug:"fundamentos/tokens-bpe"},{title: pt ? "Posição e RoPE" : "Position and RoPE",slug:"fundamentos/rope"}] },
  { icon: "code" as const, title: pt ? "Programe com o motor" : "Program with the engine", text: pt ? "Use o mesmo Transformer em Python: inferência, snapshots, autograd e treino." : "Use the same Transformer in Python: inference, snapshots, autograd and training.", href: "biblioteca/api-publica", links: [{title: "GlassLM",slug:"biblioteca/glasslm"},{title: pt ? "Tensor e autograd" : "Tensor and autograd",slug:"biblioteca/tensor-autograd"}] },
];
---
<section class="docs-hero" aria-labelledby="docs-hero-title">
  <div class="docs-hero-copy"><p class="eyebrow">{pt ? "DOCUMENTAÇÃO · TRANSFORMER EM NUMPY" : "DOCUMENTATION · TRANSFORMER IN NUMPY"}</p><h1 id="docs-hero-title">{pt ? "Veja o cálculo." : "See the calculation."}<br /><span>{pt ? "Entenda o modelo." : "Understand the model."}</span></h1><p>{pt ? "Do primeiro token ao gradiente: explore a rede, acompanhe os valores e abra o código que faz cada operação." : "From the first token to the gradient: explore the network, follow the values and open the code behind each operation."}</p><div class="docs-hero-actions"><a class="button button-primary" href={docs + "comecar/primeiro-experimento/"}>{pt ? "Começar um experimento" : "Start an experiment"}<Icon name="arrow-right" /></a><a class="docs-inline-link" href={base + lang + "/"}>{pt ? "Abrir laboratório" : "Open the lab"}<Icon name="arrow-up-right" /></a></div><div class="docs-hero-facts"><span><strong>4</strong>{pt ? "blocos Transformer" : "Transformer blocks"}</span><span><strong>77</strong>{pt ? "cálculos por previsão" : "calculations per prediction"}</span><span><strong>NumPy</strong>{pt ? "motor inspecionável" : "inspectable engine"}</span></div></div>
  <TransformerIllustration lang={lang} />
</section>

<section class="docs-reading-paths" aria-labelledby="docs-reading-title"><div class="docs-section-heading"><div><p class="eyebrow">{pt ? "ESCOLHA POR ONDE ENTRAR" : "CHOOSE WHERE TO START"}</p><h2 id="docs-reading-title">{pt ? "Explore. Entenda. Experimente." : "Explore. Understand. Experiment."}</h2></div></div><ol>{routes.map((route,i)=><li><div class="docs-path-top"><span>{String(i+1).padStart(2,"0")}</span><Icon name={route.icon} /></div><h3><a href={docs+route.href+"/"}>{route.title}<Icon name="arrow-up-right" /></a></h3><p>{route.text}</p><div class="docs-path-links">{route.links.map(link=><a href={docs+link.slug+"/"}>{link.title}</a>)}</div></li>)}</ol></section>

<DocumentationFlow lang={lang} />

<section class="docs-observation docs-section" aria-labelledby="docs-observation-title"><div><p class="eyebrow">{pt ? "DO MAPA AOS NÚMEROS" : "FROM DIAGRAM TO VALUES"}</p><h2 id="docs-observation-title">{pt ? "Dê tempo para cada etapa." : "Make time for each step."}</h2><p>{pt ? "Ative slow motion, pause em Q, K ou V e compare a equação com a matriz calculada. O inspetor mostra dimensões, estatísticas e a linha de Python que gerou o resultado." : "Enable slow motion, pause at Q, K or V and compare the equation with the computed matrix. The inspector shows dimensions, statistics and the Python line that produced the result."}</p><ul class="docs-observation-steps"><li><span>01</span>{pt ? "Gere um token real." : "Generate an actual token."}</li><li><span>02</span>{pt ? "Pause no cálculo que deseja estudar." : "Pause at the calculation you want to study."}</li><li><span>03</span>{pt ? "Leia a explicação, os valores e o código." : "Read the explanation, values and source."}</li></ul><a class="docs-inline-link" href={docs+"interface/slow-motion/"}>{pt ? "Guia do slow motion" : "Slow-motion guide"}<Icon name="arrow-right" /></a></div><figure><a href={docs+"interface/inspetor/"}><img src={base+"docs/screenshots/"+lang+"/inspector-mask.png"} alt={pt ? "Inspetor real da máscara causal: posições futuras com −∞, matriz e linha do código" : "Actual causal-mask inspector: future positions marked −∞, matrix and source line"} loading="lazy" /></a><figcaption>{pt ? "A máscara causal impede acesso a posições futuras. Veja seus valores no inspetor." : "The causal mask blocks access to future positions. Inspect its actual values."}</figcaption></figure></section>

<section class="docs-section docs-bridge" aria-labelledby="docs-bridge-title"><div class="docs-section-heading"><div><p class="eyebrow">{pt ? "UMA BIBLIOTECA, DUAS FORMAS DE EXPLORAR" : "ONE LIBRARY, TWO WAYS TO EXPLORE"}</p><h2 id="docs-bridge-title">{pt ? "O site usa o mesmo motor Python." : "The site uses the same Python engine."}</h2></div></div><div class="docs-bridge-flow"><div><Icon name="play" /><h3>{pt ? "Laboratório" : "Lab"}</h3><p>{pt ? "Controles, mapa e matrizes" : "Controls, diagram and matrices"}</p><code>TypeScript</code></div><Icon name="arrow-right" class="icon docs-bridge-arrow" /><div class="docs-bridge-runtime"><Icon name="layers" /><h3>Web Worker</h3><p>{pt ? "Python no navegador" : "Python in the browser"}</p><code>Pyodide · wheel</code></div><Icon name="arrow-right" class="icon docs-bridge-arrow" /><div><Icon name="code" /><h3>glassllm</h3><p>{pt ? "Modelo, autograd e snapshots" : "Model, autograd and snapshots"}</p><code>Python · NumPy</code></div></div><p class="docs-section-intro">{pt ? "A geração roda localmente depois do carregamento do runtime e dos pesos. A interface recebe os resultados e reproduz o percurso; o treino é executado pela biblioteca em Python." : "Generation runs locally after loading the runtime and weights. The interface receives results and replays the path; training runs through the Python library."}</p><a class="docs-inline-link" href={docs+"projeto/integracao-browser/"}>{pt ? "Entender a integração" : "Understand the integration"}<Icon name="arrow-right" /></a></section>

<section class="docs-section" id="page-tree"><div class="docs-section-heading"><div><p class="eyebrow">{pt ? "CONSULTE QUANDO PRECISAR" : "LOOK IT UP WHEN YOU NEED IT"}</p><h2>{pt ? "Toda a documentação" : "All documentation"}</h2></div><span class="docs-flow-badge">35 {pt ? "páginas por idioma" : "pages per language"}</span></div><p class="docs-section-intro">{pt ? "Guias de uso, fundamentos, referência das funções e artigos organizados pelo caminho que você está estudando." : "Usage guides, foundations, function reference and papers organized around the path you are studying."}</p><div class="docs-group-grid">{docGroups.map((group,i)=><section class="docs-group-card"><div class="docs-group-heading"><span>{String(i+1).padStart(2,"0")}</span><h3>{group.title[lang]}</h3><small>{docPages.filter(page=>page.group===group.id).length}</small></div><p>{group.description[lang]}</p><ol>{docPages.filter(page=>page.group===group.id).map(page=><li><a href={docs+page.slug+"/"}>{page.title[lang]}<Icon name="arrow-up-right" /></a></li>)}</ol></section>)}</div></section>
