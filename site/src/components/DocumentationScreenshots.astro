---
import Icon from "./Icon.astro";
import { screenshotPlans } from "../lib/docs-plan";
interface Props { lang: "pt" | "en"; ids: string[] }
const { lang, ids } = Astro.props;
const pt = lang === "pt";
const base = import.meta.env.BASE_URL;
const shots = screenshotPlans.filter(shot => ids.includes(shot.id));
---
{shots.length > 0 && <section class="docs-section"><h2>{pt ? "Veja na interface" : "See it in the interface"}</h2><div class="docs-figures">{shots.flatMap(shot=>shot.captures.map(capture=>{
  const url = base + "docs/screenshots/" + lang + "/" + capture.file;
  return <figure class:list={["docs-figure", {"docs-figure-compact": capture.compact}]}><a href={url} target="_blank" rel="noreferrer" aria-label={(pt ? "Ampliar: " : "Enlarge: ")+capture.label[lang]}><img src={url} alt={shot.title[lang]+": "+capture.label[lang]} loading="lazy" /></a><figcaption><strong>{capture.label[lang]}</strong><p>{shot.focus[lang]}</p><small>{pt ? "Captura real da interface em português." : "Actual screenshot of the English interface."}</small><br /><a class="docs-figure-action" href={url} target="_blank" rel="noreferrer"><Icon name="maximize" />{pt ? "Abrir no tamanho original" : "Open original size"}</a></figcaption></figure>;
}))}</div></section>}
