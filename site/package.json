{
  "name": "glassllm-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:wheel": "node scripts/prepare-wheel.mjs",
    "prepare:inventory": "python3 ../scripts/build_api_inventory.py",
    "prepare:site": "npm run prepare:inventory && npm run prepare:wheel",
    "clean": "node scripts/clean.mjs",
    "dev": "npm run prepare:site && astro dev",
    "check": "npm run prepare:site && astro check",
    "build": "npm run clean && npm run prepare:site && astro build",
    "preview": "astro preview",
    "capture:docs": "node scripts/capture-docs.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@fontsource-variable/source-code-pro": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "typescript": "5.8.3"
  }
}
